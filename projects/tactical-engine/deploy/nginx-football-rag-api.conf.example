limit_req_zone $binary_remote_addr zone=rag_api:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name rag.example.com;

    ssl_certificate /etc/letsencrypt/live/rag.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rag.example.com/privkey.pem;

    client_max_body_size 16k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 930s;
    proxy_send_timeout 30s;

    location / {
        limit_req zone=rag_api burst=5 nodelay;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 80;
    server_name rag.example.com;
    return 301 https://$host$request_uri;
}
