{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://football-data-lab.local/schemas/tactical_semantic_support_gold_s2_manifest_v1.json",
  "title": "FOOTBALL-DATA-LAB Tactical Semantic Support Gold S2 Freeze Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_status", "dataset", "canonicalization_profile", "case_count", "cases", "dependencies", "frozen_at", "holder_authorization_id", "parent_manifest_sha256", "supersedes_manifest_sha256", "immutable_after_freeze"],
  "properties": {
    "schema_version": {"const": "tactical_semantic_support_gold_s2_manifest_v1"},
    "manifest_status": {"enum": ["draft", "frozen"]},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "canonicalization_profile": {"const": "gold_s2_rfc8785_nfc_v1"},
    "case_count": {"type": "integer", "minimum": 0},
    "cases": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "sha256", "split_id"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "split_id": {"enum": ["development", "calibration", "holdout", "adversarial"]}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "object"}},
    "frozen_at": {"type": ["string", "null"]},
    "holder_authorization_id": {"type": ["string", "null"]},
    "parent_manifest_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "supersedes_manifest_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "immutable_after_freeze": {"type": "boolean"}
  }
}
